{
  "name": "pip-presentation-intelligence-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "generate:library": "node scripts/generate-library.mjs && node scripts/integrate-hero-references.mjs",
    "generate:previews": "node scripts/generate-library.mjs --previews-only",
    "generate:hero-references": "node scripts/generate-hero-references.mjs",
    "validate:hero-references": "node scripts/validate-hero-references.mjs",
    "integrate:hero-references": "node scripts/integrate-hero-references.mjs",
    "validate:data": "node scripts/library-quality.mjs validate",
    "report:coverage": "node scripts/library-quality.mjs coverage",
    "check:duplicates": "node scripts/library-quality.mjs duplicates",
    "report:diversity": "vitest run src/tests/relevanceDiversity.test.ts --reporter=verbose",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@vitejs/plugin-react": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "autoprefixer": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jsdom": "latest",
    "postcss": "latest",
    "tailwindcss": "3.4.17",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
