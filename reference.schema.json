{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isupovslava-collab.github.io/pip/reference.schema.json",
  "title": "PIP Reference Library",
  "type": "array",
  "minItems": 100,
  "maxItems": 100,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "title", "summary", "sourceType", "sourceLabel", "sourceUrl", "sourceBacked", "sourceTitle", "sourceOrganization", "rightsStatus", "sourceNotes", "sourceAccessCheckedAt", "previewMode", "qualityTier", "primaryContentTypeId", "screenSuitable", "visualReferenceQuality", "curatedCoreStatus", "productionApproved", "heroScenarioId", "compositionFamily", "visualDirection", "referenceSchemaVersion", "previewPath", "scenarioIds", "personaIds", "goalIds", "styleIds", "contentTypeIds", "category", "tags", "useWhen", "avoidWhen", "designDna"],
    "properties": {
      "id": { "type": "string", "pattern": "^REF-[0-9]{6}$" },
      "title": { "type": "string", "minLength": 1 },
      "summary": { "type": "string", "minLength": 1 },
      "sourceType": { "type": "string", "minLength": 1 },
      "sourceLabel": { "type": "string", "minLength": 1 },
      "sourceUrl": { "type": ["string", "null"], "format": "uri" },
      "sourceBacked": { "type": "boolean" },
      "sourceTitle": { "type": ["string", "null"] },
      "sourceOrganization": { "type": ["string", "null"] },
      "rightsStatus": { "type": ["string", "null"], "enum": ["public-link-reference-only", "licensed-for-reuse", "public-domain", "cc-licensed", "unknown-link-only", null] },
      "sourceNotes": { "type": ["string", "null"] },
      "sourceAccessCheckedAt": { "type": ["string", "null"], "format": "date" },
      "previewMode": { "enum": ["original_pip_interpretation", "licensed_original_preview"] },
      "qualityTier": { "enum": ["hero", "gold", "standard", "prototype"] },
      "primaryContentTypeId": { "enum": ["kpi", "comparison", "timeline", "process", "dashboard", "cover", "story", "table"] },
      "screenSuitable": { "type": "boolean" },
      "visualReferenceQuality": { "enum": ["premium", "good", "schematic", "prototype", "unknown"] },
      "curatedCoreStatus": { "enum": ["eligible", "review_only", "excluded"] },
      "productionApproved": { "type": "boolean" },
      "heroScenarioId": { "type": ["string", "null"], "enum": ["sales", "speech", "project", "meeting", "report", "training", "strategy", "budget_defense", null] },
      "compositionFamily": { "type": "string", "minLength": 1 },
      "visualDirection": { "type": "string", "minLength": 1 },
      "referenceSchemaVersion": { "type": "integer", "minimum": 2 },
      "previewPath": { "type": "string", "pattern": "^previews/REF-[0-9]{6}\\.(svg|png|webp)$" },
      "scenarioIds": { "$ref": "#/$defs/scenarioIds" },
      "personaIds": { "$ref": "#/$defs/personaIds" },
      "goalIds": { "$ref": "#/$defs/goalIds" },
      "styleIds": { "$ref": "#/$defs/styleIds" },
      "contentTypeIds": { "$ref": "#/$defs/contentTypeIds" },
      "category": { "type": "string", "minLength": 1 },
      "tags": { "$ref": "#/$defs/nonEmptyStrings" },
      "useWhen": { "$ref": "#/$defs/nonEmptyStrings" },
      "avoidWhen": { "$ref": "#/$defs/nonEmptyStrings" },
      "designDna": {
        "type": "object",
        "additionalProperties": false,
        "required": ["minimalism", "corporate", "executive", "modern", "whitespace", "dataDensity", "formality", "visualComplexity"],
        "properties": {
          "minimalism": { "$ref": "#/$defs/score" }, "corporate": { "$ref": "#/$defs/score" },
          "executive": { "$ref": "#/$defs/score" }, "modern": { "$ref": "#/$defs/score" },
          "whitespace": { "$ref": "#/$defs/score" }, "dataDensity": { "$ref": "#/$defs/score" },
          "formality": { "$ref": "#/$defs/score" }, "visualComplexity": { "$ref": "#/$defs/score" }
        }
      }
    }
  },
  "$defs": {
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "scenarioIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["sales", "speech", "project", "meeting", "report", "training", "strategy", "budget_defense"] }
    },
    "personaIds": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["ceo", "cfo", "board", "manager", "employees", "technical_experts", "team", "client"] }
    },
    "goalIds": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["approve", "decide", "align", "explain_results", "teach", "explain_problem", "compare_options", "inspire"] }
    },
    "styleIds": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["executive", "corporate", "consulting", "modern", "industrial", "minimal"] }
    },
    "contentTypeIds": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["kpi", "comparison", "timeline", "process", "dashboard", "cover", "story", "table"] }
    },
    "nonEmptyStrings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
